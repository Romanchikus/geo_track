{
  "queues": [
    {
      "name": "telemetry",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "stream",
        "x-max-length-bytes": 1073741824
      }
    }
  ],
  "bindings": [
    {
      "source": "amq.topic",
      "vhost": "/",
      "destination": "telemetry",
      "destination_type": "queue",
      "routing_key": "telemetry"
    }
  ]
}
